# Storage
KHIDKI_DB=data/khidki.db                         # SQLite file
KHIDKI_SESSIONS_DB=sqlite+aiosqlite:///data/sessions.db   # agent conversation memory (optional; in-memory if unset)

# Data
OPENAQ_API_KEY=                                  # https://explore.openaq.org (free) — live monitor readings

# Language model (any OpenAI-compatible endpoint)
KHIDKI_LLM_BASE=https://api.venice.ai/api/v1
KHIDKI_LLM_KEY=                                  # or VENICE_API_KEY
KHIDKI_CHAT_MODEL=claude-haiku-5-5               # planner agent
KHIDKI_AUDIT_MODEL=claude-sonnet-5-5             # auditor agent

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=                         # random string; also passed to setWebhook

# Scheduler
KHIDKI_JOB_TOKEN=                                # bearer token for POST /jobs/tick

# Web
KHIDKI_CORS=https://khidki.app                   # comma-separated allowed origins

# Production only
LITESTREAM_BUCKET=                               # GCS bucket for database replication
